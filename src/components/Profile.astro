---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profileImg from '../assets/profile.jpg';
import { AUTHOR_BIO, AUTHOR_NAME } from '../consts';
import { getReadingTime } from '../utils/readingTime';

const posts = await getCollection('blog');
const tagCount = new Set(posts.flatMap((p) => p.data.tags)).size;
const totalMinutes = posts.reduce((sum, p) => sum + getReadingTime(p.body || ''), 0);
const pad = (n: number) => String(n).padStart(3, '0');
---

<aside class="profile" aria-label="作者信息">
	<Image class="p-avatar" src={profileImg} alt={AUTHOR_NAME} width={128} height={128} />
	<p class="p-name">{AUTHOR_NAME}</p>
	<p class="p-handle">yukii@blog:~$</p>
	<p class="p-bio">{AUTHOR_BIO}。</p>
	<div class="p-rows">
		<div class="p-row">
			<span class="p-key">ROLE</span>
			<span class="p-val">开发者</span>
		</div>
		<div class="p-row">
			<span class="p-key">POSTS</span>
			<span class="p-val">{pad(posts.length)}</span>
		</div>
		<div class="p-row">
			<span class="p-key">TAGS</span>
			<span class="p-val">{pad(tagCount)}</span>
		</div>
		<div class="p-row">
			<span class="p-key">MIN READ</span>
			<span class="p-val">{pad(totalMinutes)}</span>
		</div>
		<div class="p-row">
			<span class="p-key">STATUS</span>
			<span class="p-val p-status">ACTIVE</span>
		</div>
	</div>
	<nav class="p-links" aria-label="个人链接">
		<a
			class="p-link"
			href="https://github.com/Yukii-1024"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="访问 Yukii 的 GitHub"
			title="GitHub"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					stroke="none"
					d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.26c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"
				/>
			</svg>
		</a>
		<a
			class="p-link"
			href="mailto:hcmsemails@163.com"
			aria-label="发送邮件给 Yukii"
			title="邮件"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
				<path d="m4 7 8 6 8-6"></path>
			</svg>
		</a>
	</nav>
</aside>

<style>
	.profile {
		position: fixed;
		left: 2em;
		top: 38%;
		transform: translateY(-50%);
		width: 240px;
		padding: 1.5em 1.4em;
		background: #ffffff;
		border: 1px solid var(--border);
		box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.05);
		z-index: 5;
		display: none;
	}
	/* 只在宽屏显示：保证不与 720px 正文区重叠 */
	@media (min-width: 1280px) {
		.profile {
			display: block;
		}
	}

	.p-avatar {
		display: block;
		width: 64px;
		height: 64px;
		object-fit: cover;
		border: 1px solid #1a1a1a;
		border-radius: 50%;
		box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.08);
		margin: 0 auto 0.9em;
	}
	.p-name {
		margin: 0;
		font-size: 1.05em;
		font-weight: 700;
		color: #000000;
		text-align: center;
	}
	.p-handle {
		margin: 0.1em 0 0.9em 0;
		font-family: var(--mono);
		font-size: 0.72em;
		color: rgb(var(--gray));
		text-align: center;
	}
	.p-bio {
		margin: 0 0 1em 0;
		font-size: 0.85em;
		line-height: 1.7;
		color: rgb(var(--gray));
		text-align: center;
	}

	.p-rows {
		display: flex;
		flex-direction: column;
		gap: 0.45em;
		border-top: 1px solid var(--border);
		padding: 0.9em 0;
		font-family: var(--mono);
		font-size: 0.75em;
	}
	.p-row {
		display: flex;
		justify-content: space-between;
	}
	.p-key {
		color: rgb(var(--gray));
		letter-spacing: 0.1em;
	}
	.p-val {
		color: rgb(var(--text));
	}
	.p-status::before {
		content: '●';
		margin-right: 0.5em;
		font-size: 0.7em;
		animation: p-blink 1.6s steps(1) infinite;
	}
	.p-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.7em;
		border-top: 1px solid var(--border);
		padding-top: 0.9em;
	}
	.p-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		color: rgb(var(--text));
		border: 1px solid var(--border);
		text-decoration: none;
		transition:
			color 0.15s,
			background 0.15s,
			transform 0.15s,
			box-shadow 0.15s;
	}
	.p-link:hover {
		color: #ffffff;
		background: #1a1a1a;
		transform: translate(-1px, -1px);
		box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.12);
	}
	.p-link:focus-visible {
		outline: 2px solid #1a1a1a;
		outline-offset: 3px;
	}
	.p-link svg {
		width: 1.2rem;
		height: 1.2rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	@keyframes p-blink {
		50% { opacity: 0; }
	}

</style>
