---
import type { CollectionEntry } from 'astro:content';
import { AUTHOR_NAME, categoryLabel } from '../consts';
import { getReadingTime } from '../utils/readingTime';

interface Props {
	post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
---

<li class="blog-card">
	<h3 class="blog-card-title">
		<a href={`/blog/${post.id}/`}>{post.data.title}</a>
	</h3>
	<p class="blog-card-desc">{post.data.description}</p>
	<div class="blog-card-meta">
		<span class="blog-card-meta-item">
			<svg viewBox="0 0 1024 1024" fill="currentColor"><path d="M649.6 633.6c86.4-48 147.2-144 147.2-249.6 0-160-128-288-288-288s-288 128-288 288c0 108.8 57.6 201.6 147.2 249.6-121.6 48-214.4 153.6-240 288-3.2 9.6 0 19.2 6.4 25.6 3.2 9.6 12.8 12.8 22.4 12.8h704c9.6 0 19.2-3.2 25.6-12.8 6.4-6.4 9.6-16 6.4-25.6-25.6-134.4-121.6-240-243.2-288z"/></svg>
			{AUTHOR_NAME}
		</span>
		<span class="blog-card-meta-item">
			<svg viewBox="0 0 1024 1024" fill="currentColor"><path d="M716.4 110.137c0-18.753-14.72-33.473-33.472-33.473-18.753 0-33.473 14.72-33.473 33.473v33.473h66.993v-33.473zm-334.87 0c0-18.753-14.72-33.473-33.473-33.473s-33.52 14.72-33.52 33.473v33.473h66.993v-33.473zm468.81 33.52H716.4v100.465c0 18.753-14.72 33.473-33.472 33.473a33.145 33.145 0 01-33.473-33.473V143.657H381.53v100.465c0 18.753-14.72 33.473-33.473 33.473a33.145 33.145 0 01-33.473-33.473V143.657H180.6A134.314 134.314 0 0046.66 277.595v535.756A134.314 134.314 0 00180.6 947.289h669.74a134.36 134.36 0 00133.94-133.938V277.595a134.314 134.314 0 00-133.94-133.938zm33.473 267.877H147.126a33.145 33.145 0 01-33.473-33.473c0-18.752 14.72-33.473 33.473-33.473h736.687c18.752 0 33.472 14.72 33.472 33.473a33.145 33.145 0 0133.473 33.473z"/></svg>
			{post.data.pubDate.getFullYear()}/{post.data.pubDate.getMonth() + 1}/{post.data.pubDate.getDate()}
		</span>
		<span class="blog-card-meta-item">
			<svg viewBox="0 0 1024 1024" fill="currentColor"><path d="M799.387 122.15c4.402-2.978 7.38-7.897 7.38-13.463v-1.165c0-8.933-7.38-16.312-16.312-16.312H256.33c-8.933 0-16.311 7.38-16.311 16.312v1.165c0 5.825 2.977 10.874 7.637 13.592 4.143 194.44 97.22 354.963 220.201 392.763-122.204 37.542-214.893 196.511-220.2 389.397-4.661 5.049-7.638 11.651-7.638 19.03v5.825h566.49v-5.825c0-7.379-2.849-13.981-7.509-18.9-5.049-193.016-97.867-351.985-220.2-389.527 123.24-37.67 216.446-198.453 220.588-392.892zM531.16 450.445v352.632c117.674 1.553 211.787 40.778 211.787 88.676H304.097c0-48.286 95.149-87.382 213.728-88.676V450.445c-93.077-3.107-167.901-81.297-167.901-177.093 0-8.803 6.99-15.793 15.793-15.793 8.803 0 15.794 6.99 15.794 15.793 0 80.261 63.69 145.635 142.01 145.635s142.011-65.374 142.011-145.635c0-8.803-6.99-15.793-15.793-15.793s-15.794 6.99-15.794 15.793c0 95.019-63.689 172.82-165.96 177.093z"/></svg>
			大约 {getReadingTime(post.body || '')} 分钟
		</span>
		<a class="tag" href={`/${post.data.category}/`}>{categoryLabel(post.data.category)}</a>
		{post.data.tags.length > 0 && (
			<span class="tag-list">
				{post.data.tags.map((tag) => (
					<span class="tag">{tag}</span>
				))}
			</span>
		)}
	</div>
</li>
