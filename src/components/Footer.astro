---
import {
	SITE_TITLE,
	ICP_NUMBER,
	ICP_URL,
	PUBLIC_SECURITY_NUMBER,
	PUBLIC_SECURITY_URL,
} from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<span class="eof">[EOF]</span>
		<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
		<span class="dot">·</span>
		<span>Powered by <a href="https://astro.build" target="_blank">Astro</a></span>
	</div>
	<div class="filings">
		<a href={ICP_URL} target="_blank" rel="noopener noreferrer">{ICP_NUMBER}</a>
		<span class="dot">·</span>
		<a href={PUBLIC_SECURITY_URL} target="_blank" rel="noopener noreferrer">
			<img src="/beian.png" alt="公安备案图标" width="18" height="20" />
			<span>{PUBLIC_SECURITY_NUMBER}</span>
		</a>
	</div>
</footer>

<style>
	footer {
		padding: 2em 1em;
		text-align: center;
		color: rgb(var(--gray));
		font-family: var(--mono);
		font-size: 0.78em;
		letter-spacing: 0.02em;
		border-top: 1px solid var(--border);
	}
	.footer-inner {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.6em;
	}
	.eof {
		color: rgb(var(--gray));
		opacity: 0.55;
	}
	.dot {
		color: rgba(var(--gray), 0.4);
	}
	.filings {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.3em 0.55em;
		margin-top: 0.75em;
		font-size: 0.95em;
	}
	.filings a {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
	}
	.filings img {
		display: block;
		flex-shrink: 0;
		width: 18px;
		height: 20px;
		border: 0;
	}
	footer a {
		color: rgb(var(--gray));
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	footer a:hover {
		color: rgb(var(--text));
	}
	@media (max-width: 480px) {
		.filings {
			flex-direction: column;
			gap: 0.25em;
		}
		.filings .dot {
			display: none;
		}
	}
</style>
